# バックエンドサーバー API URL
# iOSシミュレータまたはWeb環境では http://localhost:8080 を使用します。
# Androidエミュレータからローカルホストにアクセスする場合は http://10.0.2.2:8080 を使用합니다。
API_URL='http://localhost:8080'
WEB_BASE_URL='http://localhost:3000'

# 接続先は --dart-define=APP_ENV=dev|prod で切り替える:
#   未指定       → .env.development (ローカル, デフォルト)
#   APP_ENV=dev  → .env.remote-dev  (共有の開発用サーバー: rusui-dev + Cloudflare)
#   APP_ENV=prod → .env.production  (本番。リリースビルドはAPP_ENV未指定でも自動的にこちらになる)
#
# 共有dev環境に接続する場合は、このファイルをコピーして .env.remote-dev を作成し、
# API_URL/WEB_BASE_URLを該当サーバーのURLに変更した上で:
#   flutter run --dart-define=APP_ENV=dev
